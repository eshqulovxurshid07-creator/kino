{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "s-maxage=31536000,immutable" },
      "continue": true
    },
    { "src": "/favicon.ico", "continue": true },
    { "src": "/manifest.json", "continue": true },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
